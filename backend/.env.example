# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/azure_architect

# Application settings
APP_NAME=Azure Architect Companion
DEBUG=False

# Terraform execution (M7)
TERRAFORM_BINARY=terraform
TERRAFORM_WORKSPACE_ROOT=./terraform_workspaces
TERRAFORM_COMMAND_TIMEOUT_SECONDS=600
TERRAFORM_COMMAND_OUTPUT_LIMIT=100000

# Azure Resource Intelligence (M10, read-only)
# Prefer managed identity or workload identity through DefaultAzureCredential.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CREDENTIAL_MODE=default
AZURE_INTELLIGENCE_CACHE_TTL_SECONDS=3600
AZURE_INTELLIGENCE_TIMEOUT_SECONDS=30
AZURE_INTELLIGENCE_MAX_RETRIES=2

# For local service-principal use only; inject securely and never commit a value.
AZURE_CLIENT_SECRET=
